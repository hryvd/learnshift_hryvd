<?xml version="1.0" encoding="utf-8"?>
<!--
  LearnShift Sentinel Accessibility configuration (Blueprint v2 Section 2.2).
  android:canRetrieveWindowContent="false" blocks access to the window hierarchy.
  ScrollService also never accesses event text/source, screenshots or typed keys.
  Do NOT set android:isAccessibilityTool so LearnShift follows the standard
  prominent-disclosure Play Store compliance path (Section 5).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/a11y_description" />

