{
  "id": "/teacher",
  "name": "LearnShift for Teachers",
  "short_name": "LearnShift Teachers",
  "description": "See every student's skill gaps, turn lesson files into flashcards and quizzes, and check the AI tutor's answers. Learning data only, never screen time.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F6F5F1",
  "theme_color": "#C8400F",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/screenshots/classes.png", "sizes": "1366x768", "type": "image/png", "form_factor": "wide", "label": "Class mastery at a glance" },
    { "src": "/screenshots/studio.png", "sizes": "1366x768", "type": "image/png", "form_factor": "wide", "label": "Turn a lesson file into flashcards and a quiz" },
    { "src": "/screenshots/invite.png", "sizes": "1366x768", "type": "image/png", "form_factor": "wide", "label": "Invite students with a QR code" },
    { "src": "/screenshots/signin.png", "sizes": "1366x768", "type": "image/png", "form_factor": "wide", "label": "Sign in or create a teacher account" }
  ]
}
